{
  "version": 1,
  "layers": ["regex"],
  "fail_on": "high",
  "min_confidence": 0.9,
  "screen_threshold": 0.5,
  "entity_types": [
    "AWS_ACCESS_KEY", "AWS_SECRET_KEY", "PASSWORD", "USERNAME", "IP_ADDRESS", "EMAIL",
    "CREDIT_DEBIT_NUMBER", "PHONE", "SSN", "BANK_ACCOUNT_NUMBER", "NAME", "ADDRESS"
  ],
  "severity": {
    "critical": ["AWS_ACCESS_KEY", "AWS_SECRET_KEY", "PASSWORD", "CREDIT_DEBIT_NUMBER", "SSN"]
  },
  "validation_patterns": {
    "AWS_ACCESS_KEY": "(?:AKIA|ASIA)[0-9A-Z]{16}",
    "AWS_SECRET_KEY": "[A-Za-z0-9/+=]{40}"
  },
  "exclude": {
    "dirs": ["dist", "build"],
    "extensions": [".png", ".jpg"]
  },
  "limits": {
    "workers": 16,
    "max_file_size": 10000000
  },
  "aws": {
    "region": "us-east-1",
    "tps_contains": 20,
    "tps_detect": 40
  },
  "mask": {
    "style": "label"
  }
}
