{
  "rules": [
    {
      "id": "employee-id",
      "pattern": "\\bEMP-\\d{6}\\b",
      "severity": "medium"
    },
    {
      "id": "project-code",
      "pattern": "\\bPROJ-[A-Z]{3}-\\d{4}\\b",
      "severity": "low"
    },
    {
      "id": "jdbc-password",
      "type": "CONNECTION_STRING",
      "pattern": "(?i)jdbc:[a-z0-9]+://[^\\s;]*;password=([^;\\s]+)",
      "group": 1
    }
  ]
}
