#!/usr/bin/env python3
"""Compatibility entry point: `./pii_scan [options]` runs the installed `pii-scan` command.

Prefer `uv run pii-scan ...` or `uvx --from git+https://github.com/ventz/pii-scan pii-scan ...`.
"""

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent / "src"))

from pii_scan.cli import main  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(main())
